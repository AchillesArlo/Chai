# Production Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control
#
# SECURITY: In production, use a secrets manager (AWS Secrets Manager,
# HashiCorp Vault, etc.) instead of plaintext .env files.

# =============================================================================
# Application
# =============================================================================

APP_ENV=production
LOG_LEVEL=info

# =============================================================================
# PostgreSQL Database
# =============================================================================

POSTGRES_DB=chai
POSTGRES_USER=chai_admin
# Generate: openssl rand -base64 48
POSTGRES_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=200

# -----------------------------------------------------------------------------
# Runtime database roles (tenant isolation — see migration 0051)
# -----------------------------------------------------------------------------
# POSTGRES_USER above is the schema OWNER / bootstrap superuser. It is used ONLY
# by the one-shot `migrate` service (DDL: schema, roles, and RLS policies).
#
# The api and workers MUST NOT connect as a superuser. A superuser — and any
# BYPASSRLS role — bypasses Row-Level Security unconditionally, so FORCE RLS +
# USING(false) still returns every tenant's rows and tenant isolation is OFF.
# The runtime connects instead as the NOBYPASSRLS LOGIN roles migration 0051
# creates:
#   chai_api    -> the API      (member of chai_app_runtime)
#   chai_worker -> every worker  (member of chai_worker_runtime)
# The role names are hard-coded in docker-compose.yml (not overridable via env),
# so a misconfiguration can never point the runtime back at the superuser.
#
# Migrations must never carry a secret, so 0051 creates these roles WITHOUT a
# password. After the FIRST migrate, provision the passwords out-of-band from
# your secrets manager (connected as POSTGRES_USER), e.g.:
#   ALTER ROLE chai_api    PASSWORD '<CHAI_API_DB_PASSWORD>';
#   ALTER ROLE chai_worker PASSWORD '<CHAI_WORKER_DB_PASSWORD>';
# A passwordless role cannot authenticate under scram-sha-256, so the default is
# fail-closed. These values are interpolated into DATABASE_URL, so use URL-safe
# passwords (or URL-encode reserved characters @ : / ?).
# Generate: openssl rand -base64 48
CHAI_API_DB_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
CHAI_WORKER_DB_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER

# =============================================================================
# Redis
# =============================================================================

# Generate: openssl rand -base64 48
REDIS_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379

# =============================================================================
# API Service
# =============================================================================

API_PORT=3000
# NOTE: API_REPLICAS removed — docker-compose.yml hardcodes `deploy.replicas` and
# never interpolated ${API_REPLICAS}; no application code reads it either.

# =============================================================================
# Analytics Worker (burn-rate harvester)
# =============================================================================

# The analytics-worker takes its tenants from chai.active_tenant_roster() (the
# live DB roster, re-read every cycle) — NOT from an env var. Do NOT set a roster
# env here: the legacy ANALYTICS_TENANT_ROSTER is REJECTED at startup
# (packages/database/src/tenant-roster-loop.ts) to stop a stale second source of
# truth. The worker fails hard only if that FIRST DB roster read fails.
#
# All of these are OPTIONAL (workers/analytics-worker/src/main.ts):
#   ANALYTICS_BURN_RATE_INTERVAL_MS  harvest + roster-refresh cadence, ms (default 60000)
#   ANALYTICS_SLO_ID                 SLO id sampled (default outbox-delivery)
#   ANALYTICS_SLO_OBJECTIVE          objective, in (0,1) (default 0.999)
#   ANALYTICS_SLO_PERIOD_DAYS        rolling window in days (default 30)
ANALYTICS_BURN_RATE_INTERVAL_MS=60000

# =============================================================================
# Frontend URLs
# =============================================================================

# Public API URL baked into each frontend's browser bundle. docker-compose maps
# these to NEXT_PUBLIC_API_URL per service.
OWNER_CONSOLE_API_URL=https://api.chai.example.com
CLIENT_PORTAL_API_URL=https://api.chai.example.com

# --- Frontend SERVER-side runtime (read per request, not at build time) ---
# The Next.js BFF proxy, middleware, and login/logout routes read
# process.env.API_URL and process.env.APP_URL directly
# (apps/{client-portal,owner-console}/src/app/api/[...path]/route.ts:16,
# apps/client-portal/src/middleware.ts:75,91,
# apps/{client-portal,owner-console}/src/app/{login/page.tsx,logout/route.ts}).
# These MUST be injected into the frontend containers by docker-compose — which
# today only sets NEXT_PUBLIC_API_URL. Without them the proxy falls back to
# http://localhost:3001 INSIDE the container and every proxied, authenticated
# call fails.
#
# API_URL: internal base URL the frontend SERVER uses to reach the API. In the
# compose network the API service is http://api:3000 (same value for both apps).
API_URL=http://api:3000
# APP_URL: the frontend's OWN public origin, used for the post-logout redirect to
# /login. owner-console and client-portal are separate containers, so each needs
# its own origin (e.g. https://chai.example.com vs https://portal.chai.example.com);
# docker-compose must set APP_URL per service.
APP_URL=https://chai.example.com

# =============================================================================
# Nginx Reverse Proxy
# =============================================================================

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# Docker Registry
# =============================================================================

DOCKER_REGISTRY=ghcr.io/chai-platform
IMAGE_TAG=latest

# =============================================================================
# Monitoring
# =============================================================================

# NOTE: ENABLE_METRICS / METRICS_PORT / ENABLE_TRACING removed — the API and
# worker containers hardcode these in docker-compose.yml (they were never read
# from .env, and no application code reads them). Telemetry export is driven
# ONLY by OTEL_EXPORTER_OTLP_ENDPOINT (injected by compose): with it unset the
# OTel SDK stays off by design (see README).

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
GRAFANA_ROOT_URL=https://grafana.chai.example.com

# =============================================================================
# Logging (ELK)
# =============================================================================

ELASTICSEARCH_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601

# =============================================================================
# Security / Auth tokens
# =============================================================================

# Shared HMAC secret for session/refresh token signing. REQUIRED.
# - Minimum 32 characters. apps/api and apps/realtime-gateway THROW at startup in
#   production when it is unset or shorter than 32 chars
#   (apps/api/src/auth/token-config.ts:14-22 -> bootstrap.ts,
#    apps/realtime-gateway/src/auth.ts:30-51). The client-portal realtime route
#   reads it too (apps/client-portal/src/app/api/realtime/conversations/route.ts:13).
# - Use the SAME value across api, realtime-gateway and client-portal.
# - Left as this placeholder (29 chars) the API refuses to boot in production —
#   that fail-closed behaviour is intentional; replace it via your secrets manager.
# Generate: openssl rand -base64 48
AUTH_TOKEN_SECRET=CHANGE_ME_USE_SECRETS_MANAGER
# Optional. JWT issuer claim (default 'chai-platform'); keep consistent across services.
AUTH_TOKEN_ISSUER=chai-platform

# =============================================================================
# Connectors / External Providers
# =============================================================================
#
# Every connector defaults to a safe in-memory MOCK when its PROVIDER_* is unset
# or 'mock', so core runs with all optional modules off (README invariant).
# Selection + credential reads live in packages/connectors/src/factory.ts.
# Set a provider to a real value only once the matching credentials are filled.
#
#   PROVIDER_AI        mock (default) | openai | anthropic
#   PROVIDER_CHANNEL   mock (default) | whatsapp-meta
#   PROVIDER_CALENDAR  mock (default) | google-calendar
#   PROVIDER_PAYMENT   mock (default) | midtrans
#   PROVIDER_LOGISTICS mock (default) | jne
PROVIDER_AI=mock
PROVIDER_CHANNEL=mock
PROVIDER_CALENDAR=mock
PROVIDER_PAYMENT=mock
PROVIDER_LOGISTICS=mock

# Channel identity the factory stamps onto a real channel adapter
# (packages/connectors/src/factory.ts:104-105). Both default to 'default'.
API_TENANT_ID=
API_CHANNEL_ACCOUNT_ID=

# --- WhatsApp (Meta Cloud API) — used when PROVIDER_CHANNEL=whatsapp-meta ---
# packages/connectors/src/connectors/whatsapp-meta/index.ts:106-107, factory.ts:110.
# Empty ACCESS_TOKEN keeps the adapter in dry-run/sandbox mode.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# --- Midtrans (payment) — used when PROVIDER_PAYMENT=midtrans ---
# packages/connectors/src/factory.ts:84-86. MIDTRANS_ENV=production leaves sandbox.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# --- JNE (logistics) — used when PROVIDER_LOGISTICS=jne ---
# packages/connectors/src/factory.ts (createShippingAdapterFactory)
JNE_API_KEY=
JNE_USERNAME=
JNE_ORIGIN=

# --- OpenAI — used when PROVIDER_AI=openai ---
# packages/connectors/src/factory.ts (createAiAdapterFactory)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
OPENAI_ORGANIZATION=

# --- Anthropic — used when PROVIDER_AI=anthropic ---
# packages/connectors/src/factory.ts (createAiAdapterFactory)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=

# --- Google Calendar — used when PROVIDER_CALENDAR=google-calendar ---
# packages/connectors/src/factory.ts (createCalendarAdapterFactory)
GOOGLE_CALENDAR_API_BASE_URL=
GOOGLE_CALENDAR_ID=

# --- Provider kill switches (global) ---
# Set to 1 or true to trip a whole provider class; unset/0 = off.
# packages/connectors/src/kill-switch.ts:58 reads KILL_SWITCH_<PROVIDER>.
KILL_SWITCH_PAYMENT=
KILL_SWITCH_CHANNEL=
KILL_SWITCH_LOGISTICS=
KILL_SWITCH_CALENDAR=
