# Production Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control
#
# SECURITY: In production, use a secrets manager (AWS Secrets Manager,
# HashiCorp Vault, etc.) instead of plaintext .env files.

# =============================================================================
# Application
# =============================================================================

APP_ENV=production
LOG_LEVEL=info

# =============================================================================
# PostgreSQL Database
# =============================================================================

POSTGRES_DB=chai
POSTGRES_USER=chai_admin
# Generate: openssl rand -base64 48
POSTGRES_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=200

# =============================================================================
# Redis
# =============================================================================

# Generate: openssl rand -base64 48
REDIS_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
REDIS_PORT=6379
REDIS_SENTINEL_PORT=26379

# =============================================================================
# API Service
# =============================================================================

API_PORT=3000
API_REPLICAS=5

# =============================================================================
# Worker Concurrency
# =============================================================================

CHANNEL_WORKER_CONCURRENCY=10
AUTOMATION_WORKER_CONCURRENCY=5
PAYMENT_WORKER_CONCURRENCY=3
LOGISTICS_WORKER_CONCURRENCY=5
ANALYTICS_WORKER_CONCURRENCY=3
MEDIA_WORKER_CONCURRENCY=3

# =============================================================================
# Analytics Worker (burn-rate harvester)
# =============================================================================

# REQUIRED for the analytics-worker. Comma-separated tenantId:principalId pairs
# the burn-rate harvester samples each interval, e.g.
# "0189...-tenant:0189...-principal,0189...-tenant2:0189...-principal2".
# The worker fails fast on startup if this is empty.
# Optional. Harvest interval in ms (default 60000). Also tunable with defaults:
# ANALYTICS_SLO_ID (outbox-delivery), ANALYTICS_SLO_OBJECTIVE (0.999),
# ANALYTICS_SLO_PERIOD_DAYS (30).
ANALYTICS_BURN_RATE_INTERVAL_MS=60000

# =============================================================================
# Frontend URLs (public-facing)
# =============================================================================

OWNER_CONSOLE_API_URL=https://api.chai.example.com
CLIENT_PORTAL_API_URL=https://api.chai.example.com

# =============================================================================
# Nginx Reverse Proxy
# =============================================================================

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# Docker Registry
# =============================================================================

DOCKER_REGISTRY=ghcr.io/chai-platform
IMAGE_TAG=latest

# =============================================================================
# Monitoring
# =============================================================================

METRICS_PORT=9090
ENABLE_METRICS=true
ENABLE_TRACING=true

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
GRAFANA_ROOT_URL=https://grafana.chai.example.com

# =============================================================================
# Logging (ELK)
# =============================================================================

ELASTICSEARCH_PORT=9200
LOGSTASH_PORT=5044
KIBANA_PORT=5601

# =============================================================================
# External Services (API Keys / Secrets)
# =============================================================================

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@chai.example.com

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloud Storage (S3-compatible)
S3_BUCKET=chai-production-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# =============================================================================
# Security
# =============================================================================

# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_SECRETS_MANAGER
ENCRYPTION_KEY=CHANGE_ME_USE_SECRETS_MANAGER
CORS_ORIGINS=https://chai.example.com,https://portal.chai.example.com
