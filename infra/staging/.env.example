# Staging Environment Configuration
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control

# =============================================================================
# Application
# =============================================================================

# Application environment (staging)
APP_ENV=staging

# Log level: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# PostgreSQL Database
# =============================================================================

# Database name
POSTGRES_DB=chai

# Database admin user
POSTGRES_USER=chai_admin

# Database password — USE A STRONG RANDOM PASSWORD IN PRODUCTION
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-staging-password

# Exposed port for database (restrict in production)
POSTGRES_PORT=5432

# =============================================================================
# Redis
# =============================================================================

# Redis password — USE A STRONG RANDOM PASSWORD
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=change-me-redis-password

# Exposed port for Redis (restrict in production)
REDIS_PORT=6379

# =============================================================================
# API Service
# =============================================================================

# API port (internal)
API_PORT=3000

# Number of API replicas
API_REPLICAS=3

# =============================================================================
# Worker Concurrency
# =============================================================================

# Max concurrent jobs per worker instance
CHANNEL_WORKER_CONCURRENCY=5
AUTOMATION_WORKER_CONCURRENCY=3
PAYMENT_WORKER_CONCURRENCY=2
LOGISTICS_WORKER_CONCURRENCY=3
ANALYTICS_WORKER_CONCURRENCY=2
MEDIA_WORKER_CONCURRENCY=2

# =============================================================================
# Frontend URLs
# =============================================================================

# Owner Console API URL (internal Docker network)
OWNER_CONSOLE_API_URL=http://api:3000

# Client Portal API URL (internal Docker network)
CLIENT_PORTAL_API_URL=http://api:3000

# =============================================================================
# Nginx Reverse Proxy
# =============================================================================

# HTTP port (public)
NGINX_HTTP_PORT=80

# HTTPS port (public) — set to 443 in production with TLS
NGINX_HTTPS_PORT=443

# =============================================================================
# Docker Registry
# =============================================================================

# Container registry URL for pushing images
DOCKER_REGISTRY=ghcr.io/chai-platform

# Image tag (usually git commit SHA or semver)
IMAGE_TAG=latest

# =============================================================================
# Monitoring (Optional for staging)
# =============================================================================

# Prometheus metrics endpoint
METRICS_PORT=9090

# Enable Prometheus metrics collection
ENABLE_METRICS=true

# =============================================================================
# External Services (API Keys / Secrets)
# =============================================================================

# Twilio configuration (for SMS/voice channels)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@chai-staging.example.com

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloud Storage (S3-compatible)
S3_BUCKET=chai-staging-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# =============================================================================
# Security
# =============================================================================

# JWT secret for token signing — USE A STRONG RANDOM SECRET
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-jwt-secret

# Encryption key for sensitive data at rest
ENCRYPTION_KEY=change-me-encryption-key

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://staging.chai.example.com,https://staging-portal.chai.example.com
