  },
  "description": "Stage 2 workers: follow-up job queue, knowledge ingest, realtime gateway. ponytail: thresholds are first-guess; tune after load test.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "automation-worker runbook", "url": "file://docs/runbooks/automation-worker.md", "type": "link" },
    { "title": "knowledge-ingest runbook", "url": "file://docs/runbooks/knowledge-ingest.md", "type": "link" },
    { "title": "realtime-gateway runbook", "url": "file://docs/runbooks/realtime-gateway.md", "type": "link" }
  ],
  "liveNow": false,
  "panels": [
    {
      "title": "follow_up_job queue depth by status",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (chai_follow_up_job_queue)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 50 },
          { "color": "red", "value": 100 }
        ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal" }
    },
    {
      "title": "follow-up latency p95 (due_at → DONE)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chai_follow_up_job_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(chai_follow_up_job_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "follow_up_job FAILED (1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "id": 3,
      "targets": [
        { "refId": "A", "expr": "increase(chai_follow_up_job_total{status=\"FAILED\"}[1h])", "legendFormat": "FAILED 1h" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "red", "value": 10 }
        ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "title": "knowledge_document by status",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (chai_knowledge_document_total)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "pieType": "donut" }
    },
    {
      "title": "knowledge FAILED docs (1h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "id": 5,
      "targets": [
        { "refId": "A", "expr": "increase(chai_knowledge_document_total{status=\"FAILED\"}[1h])", "legendFormat": "FAILED 1h" },
        { "refId": "B", "expr": "increase(chai_knowledge_document_total{status=\"READY\"}[1h])", "legendFormat": "READY 1h" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "SSE active connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 20 },
      "id": 6,
      "targets": [
        { "refId": "A", "expr": "chai_realtime_sse_active_connections", "legendFormat": "active" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "title": "gateway ingest rate + errors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 20 },
      "id": 7,
      "targets": [
        { "refId": "A", "expr": "sum(rate(chai_realtime_ingest_total[5m]))", "legendFormat": "ingest/s" },
        { "refId": "B", "expr": "sum(rate(chai_realtime_ingest_errors_total[5m]))", "legendFormat": "errors/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "title": "gateway up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 26 },
      "id": 8,
      "targets": [
        { "refId": "A", "expr": "up{job=\"chai-realtime\"}", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 1 }
        ] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    }
  ],
  "refresh": "15s",
