{
  "name": "@chai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --alias:@chai/auth=../../packages/auth/src/index.ts --alias:@chai/contracts=../../packages/contracts/src/index.ts --sourcemap --outfile=dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test vitest.e2e.config.ts vitest.integration.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --root . --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@chai/auth": "workspace:*",
    "@chai/connector-sdk": "workspace:*",
    "@chai/connectors": "workspace:*",
    "@chai/contracts": "workspace:*",
    "@chai/database": "workspace:*",
    "@chai/domain": "workspace:*",
    "@chai/realtime-gateway": "workspace:*",
    "@fastify/helmet": "13.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@opentelemetry/api": "1.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "postgres": "3.4.8",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
