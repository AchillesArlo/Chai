{
  "name": "@chai/realtime-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/main.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test",
    "start": "tsx src/main.ts",
    "test": "vitest run --root .",
    "test:e2e": "vitest run --root . test/isolation",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chai/auth": "workspace:*",
    "@chai/contracts": "workspace:*",
    "@chai/database": "workspace:*",
    "@chai/domain": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
