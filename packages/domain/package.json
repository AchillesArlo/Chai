{
  "name": "@chai/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src test vitest.integration.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --root . --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@chai/auth": "workspace:*",
    "@chai/connector-sdk": "workspace:*",
    "@chai/contracts": "workspace:*",
    "@chai/database": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "devDependencies": {
    "@chai/testkit": "workspace:*",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "postgres": "3.4.9",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
