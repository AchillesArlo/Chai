{
  "name": "@chai/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src test vitest.integration.config.ts",
    "migrate": "node --import tsx/esm src/migrate-cli.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --root . --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@chai/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@chai/testkit": "workspace:*",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
